PORT=3000
# Allowed origin for the Angular dev server
CORS_ORIGIN=http://localhost:4200
# Where the SQLite database and uploaded files are stored
DATA_DIR=data
# Optional: set your own secret (otherwise one is generated in data/.jwt-secret)
# JWT_SECRET=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=12
TZ=Asia/Kolkata

# ---------- Booking emails ----------
# When a client books on /book, an email with the booking PDF goes to the "Booking email" set in Settings
# (or the business email). Gmail: turn on 2-step verification, create an App password, and use it as SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-letter-app-password
# SMTP_FROM=Event Pro <yourname@gmail.com>
# Link in the email to open the booking (your website address once hosted)
# APP_URL=http://localhost:4200
# Online bookings allowed per device per hour
# BOOKING_RATE_LIMIT_PER_HOUR=5

# ---------- Companies (multi-business panel) ----------
# Where "new sign-up waiting for approval" emails go (default: SMTP_USER)
# SUPER_ADMIN_EMAIL=you@gmail.com
# Aadhaar/PAN numbers and card photos are encrypted with a key kept in data/.kyc-key (created on first start).
# BACK UP data/.kyc-key together with the data folder: without it the KYC details cannot be read.
# Optional: use your own secret instead of the key file
# KYC_SECRET=a-long-random-secret
# Sign-ups allowed per device per hour
# SIGNUP_RATE_LIMIT_PER_HOUR=5
